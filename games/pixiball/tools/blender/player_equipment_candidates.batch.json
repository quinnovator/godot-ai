{
  "schema_version": 1,
  "name": "Pixiball parallel player and equipment candidates",
  "max_workers": 4,
  "result": "res://artifacts/blender_candidates/pixiball_parallel_example/batch-result.json",
  "defaults": {
    "timeout_seconds": 300
  },
  "jobs": [
    {
      "id": "player-power-pitcher",
      "script": "res://tools/blender/build_candidate.py",
      "output": "res://artifacts/blender_candidates/pixiball_parallel_example/player-power-pitcher.glb",
      "blend": "res://artifacts/blender_candidates/pixiball_parallel_example/player-power-pitcher.blend",
      "parameters": {
        "asset_type": "player",
        "candidate_id": "player-power-pitcher",
        "role": "pitcher",
        "stance": "pitcher_power",
        "style": "high_resolution_pixel_volume",
        "proportions": {
          "height": 1.08,
          "shoulder_width": 1.16,
          "stockiness": 1.12
        },
        "palette": {
          "primary": "#103E66",
          "secondary": "#DF4D46",
          "accent": "#F2BB45",
          "skin": "#A85E3A"
        }
      }
    },
    {
      "id": "player-agile-catcher",
      "script": "res://tools/blender/build_candidate.py",
      "output": "res://artifacts/blender_candidates/pixiball_parallel_example/player-agile-catcher.glb",
      "blend": "res://artifacts/blender_candidates/pixiball_parallel_example/player-agile-catcher.blend",
      "parameters": {
        "asset_type": "player",
        "candidate_id": "player-agile-catcher",
        "role": "catcher",
        "stance": "catcher_low",
        "style": "high_resolution_pixel_volume",
        "proportions": {
          "height": 0.94,
          "shoulder_width": 1.02,
          "stockiness": 1.05
        },
        "palette": {
          "primary": "#741F36",
          "secondary": "#163B61",
          "accent": "#F2C857",
          "skin": "#D08B5D"
        }
      }
    },
    {
      "id": "equipment-catcher-mitt",
      "script": "res://tools/blender/build_candidate.py",
      "output": "res://artifacts/blender_candidates/pixiball_parallel_example/equipment-catcher-mitt.glb",
      "blend": "res://artifacts/blender_candidates/pixiball_parallel_example/equipment-catcher-mitt.blend",
      "parameters": {
        "asset_type": "equipment",
        "candidate_id": "equipment-catcher-mitt",
        "equipment_kind": "mitt",
        "style": "high_resolution_pixel_volume",
        "palette": {
          "leather": "#71321E",
          "dark": "#261811",
          "accent": "#D49A4A"
        }
      }
    },
    {
      "id": "equipment-slugger-bat",
      "script": "res://tools/blender/build_candidate.py",
      "output": "res://artifacts/blender_candidates/pixiball_parallel_example/equipment-slugger-bat.glb",
      "blend": "res://artifacts/blender_candidates/pixiball_parallel_example/equipment-slugger-bat.blend",
      "parameters": {
        "asset_type": "equipment",
        "candidate_id": "equipment-slugger-bat",
        "equipment_kind": "bat",
        "style": "high_resolution_pixel_volume",
        "palette": {
          "wood": "#C98A3B",
          "dark": "#202733",
          "accent": "#F0B947"
        }
      }
    }
  ]
}
