		"steps": [
		  {"frame": "EXTENSION_FOLLOW", "until": 0.08},
		  {"frame": "FOLLOW_HIGH", "until": 9.0}
		]
	  },
	  "reactNeutral": {
		"clock": "phase",
		"steps": [{"frame": "STANCE_A", "until": 9.0}]
	  }
	}
  },
  "catcher": {
	"params": {
	  "reactU": 0.6,
	  "dropBelowZ": 1.2,
	  "riseAboveZ": 3.4,
	  "shiftBeyondX": 1.0
	},
	"tracks": {
	  "idle": {"clock": "phase", "steps": [{"frame": "CROUCH", "until": 9.0}]},
	  "drop": {"clock": "phase", "steps": [{"frame": "DROP", "until": 9.0}]},
	  "rise": {"clock": "phase", "steps": [{"frame": "RISE", "until": 9.0}]},
	  "shift": {"clock": "phase", "steps": [{"frame": "SHIFT", "until": 9.0}]},
	  "brace": {"clock": "phase", "steps": [{"frame": "BRACE", "until": 9.0}]}
	}
  },
  "mitt": {
	"params": {
	  "driftU": 0.5,
	  "easeRate": 9.0
	},
	"tracks": {
	  "open": {"clock": "phase", "steps": [{"frame": "OPEN", "until": 9.0}]},
	  "caught": {
		"clock": "phase",
		"steps": [
		  {"frame": "POP", "until": 0.09},
		  {"frame": "CLOSED", "until": 9.0}
		]
	  }
	}
  },
  "umpire": {
	"tracks": {
	  "idle": {"clock": "phase", "steps": [{"frame": "CROUCH", "until": 9.0}]},
