		  {"frame": "LEAN", "until": 0.18},
		  {"frame": "RINGUP_WIND", "until": 0.33},
		  {"frame": "RINGUP_PUNCH", "until": 9.0}
		]
	  },
	  "calledStrike": {
		"clock": "phase",
		"steps": [
		  {"frame": "CROUCH", "until": 0.18},
		  {"frame": "PUNCH", "until": 0.68},
		  {"frame": "CROUCH", "until": 9.0}
		]
	  }
	}
  }
}
