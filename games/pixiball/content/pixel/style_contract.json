{
  "schema": "pixiball.native-pixel-style.v2",
  "logical_canvas": [1280, 720],
  "native_framebuffer": [1280, 720],
  "design_canvas_units": [320, 180],
  "authoring_grid_px": 4,
  "tile_grid": [4, 4],
  "runtime": {
    "renderer": "canvas_item",
    "render_path": "direct_root_canvas",
    "pixel_scene_scale": [4, 4],
    "offscreen_intermediate": false,
    "subviewport": false,
    "framebuffer_filter": false,
    "texture_filter": "nearest_source_textures_only",
    "hidpi_aware": true,
    "window_scale_policy": "integer_only",
    "three_dimensional_assets": false,
    "postprocess_pixel_filter": false,
    "dynamic_surface_lighting": false,
    "anti_aliasing": false,
    "integer_transforms": true
  },
  "characters": {
    "avatar_language": "saltlight_pocket_giants",
    "authoring_grid_px": 4,
    "lod_names": ["marquee", "battery", "diamond"],
    "projector_lod_map": {"large": "marquee", "small": "battery", "tiny": "diamond"},
    "hero_height_px": 160,
    "hero_head_height_px": 64,
    "hero_head_ratio": 0.4,
    "midground_height_px": 88,
    "field_height_px": 44,
    "lod_heights_px": {"large": 160, "small": 88, "tiny": 44},
    "lod_head_heights_px": {"large": 64, "small": 36, "tiny": 20},
    "eye_highlight_px": 4,
    "hero_height_design_units": 40,
    "hero_head_height_design_units": 16,
    "lod_heights_design_units": {"large": 40, "small": 22, "tiny": 11},
    "lod_head_heights_design_units": {"large": 16, "small": 9, "tiny": 5},
    "eye_highlight_design_units": 1,
    "eye_highlights_by_lod": {"large": true, "small": true, "tiny": false},
    "facial_features": ["eyes", "eye_highlights", "brows", "mouth", "hair_or_headwear", "cheek_smudge", "cap_brim_shadow"],
    "animation_fps": 10,
    "maximum_ramp_tones": 4,
    "silhouette_first": true,
    "equipment_minimum_mark_px": 8,
    "equipment_minimum_mark_design_units": 2
  },
  "world": {
    "background_layers": 4,
    "cluster_grid_design_units": [8, 8],
    "cluster_grid_px": [32, 32],
    "large_quiet_color_fields": true,
    "procedural_crowd_clusters": true,
    "perspective": "authored_fixed_views",
    "view_modes": ["intro", "pitching", "batting", "fielding", "dugout"]
  },
  "palette": {
    "maximum_colors_per_frame": 32,
    "moods": ["day", "golden", "night"],
    "transparent_alpha_values": [0, 255],
    "forbid_color_gradients": true
  },
  "generation": {
    "source_kind": "declarative_pixel_clusters",
    "required_metadata": ["role", "action", "frame", "pivot", "palette_slots"],
    "validation_command": "python tools/validate_native_pixel_art.py content/pixel/style_contract.json <png...>",
    "notes": "Generated bitmaps are accepted only after 1280x720 native-framebuffer, palette, alpha, and 4px-grid validation. The 320x180 coordinate system is design space only; PixelScene scales those CanvasItems directly into the root framebuffer without an intermediate texture."
  }
}
